import { CheckBox, ListView, Palette, Slider } from "std-widgets.slint";
import { Badge, Dot } from "widgets.slint";

export struct TreeItem {
    id: string,
    name: string,
    // DMs node and guilds
    node: bool,
    expanded: bool,
    depth: int,
    // channel type: 4 = category, 1/3 = DM, 2/13 = voice
    kind: int,
    unread: bool,
    mentions: int,
    enabled: bool,
    // someone in the voice channel above (id = user id)
    member: bool,
    speaking: bool,
    muted: bool,
    deafened: bool,
    // members: our volume for them (0..2) and "mute for me"
    volume: float,
    muted-for-me: bool,
}

// DMs and guilds as collapsible nodes; channels under expanded nodes, voice channels followed by who's
// in them. Clicking a node toggles it, clicking a text channel or DM opens its tab, double-clicking a
// voice channel joins it.
export component Tree inherits Rectangle {
    in property <[TreeItem]> items;
    // the active tab's channel
    in property <string> active;
    callback toggle(string);
    callback open(string);
    callback join(string);
    // a member's volume (0..2) or "mute for me" changed (user id)
    callback set-volume(string, float);
    callback set-muted-for-me(string, bool);

    background: Palette.alternate-background;
    ListView {
        for it in root.items: Rectangle {
            property <bool> header: it.kind == 4 && !it.node;
            property <bool> voice: !it.node && !it.member && (it.kind == 2 || it.kind == 13);
            property <bool> clickable: it.node || (it.enabled && !header);
            // collapsed nodes summarise what's inside
            property <bool> show-totals: it.node && !it.expanded;
            height: 22px;
            background: it.id == root.active && !it.node ? Palette.selection-background
                : ta.has-hover && clickable ? Palette.background : transparent;
            accessible-role: list-item;
            accessible-label: it.name;
            accessible-enabled: clickable;
            accessible-expandable: it.node;
            accessible-expanded: it.expanded;
            accessible-action-default => {
                if it.member { vol.show(); } else if voice { root.join(it.id); } else { ta.clicked(); }
            }
            HorizontalLayout {
                padding-left: 6px + it.depth * 14px;
                padding-right: 6px;
                spacing: 4px;
                Text {
                    width: 12px;
                    text: it.node ? (it.expanded ? "▾" : "▸") : "";
                    vertical-alignment: center;
                    opacity: 0.7;
                }
                if it.member: Text {
                    text: "●";
                    vertical-alignment: center;
                    font-size: 9px;
                    color: it.speaking ? #3ba55c : Palette.foreground;
                    opacity: it.speaking ? 1.0 : 0.25;
                }
                if it.member: Text {
                    horizontal-stretch: 1;
                    text: it.name + (it.muted ? " 🔇" : "") + (it.deafened ? " 🎧" : "") + (it.muted-for-me ? " 🔕" : "");
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: 12px;
                    font-weight: it.speaking ? 700 : 400;
                    opacity: it.speaking ? 1.0 : 0.8;
                }
                if !it.member: Text {
                    horizontal-stretch: 1;
                    text: it.node || header || it.kind == 1 || it.kind == 3 ? it.name : (voice ? "♪ " : "# ") + it.name;
                    vertical-alignment: center;
                    overflow: elide;
                    font-size: header ? 11px : 13px;
                    font-weight: it.node || header || (it.unread && it.enabled && (!it.node || show-totals)) ? 700 : 400;
                    color: it.id == root.active && !it.node ? Palette.selection-foreground : Palette.foreground;
                    opacity: !it.enabled ? 0.4 : it.node || header || it.unread || it.id == root.active ? 1.0 : 0.7;
                }
                if show-totals && it.unread && it.mentions == 0: Dot {
                    y: (parent.height - self.height) / 2;
                    background: Palette.foreground;
                }
                Badge {
                    y: (parent.height - self.height) / 2;
                    count: it.node && it.expanded ? 0 : it.mentions;
                }
            }
            ta := TouchArea {
                enabled: clickable;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    if it.node { root.toggle(it.id); } else if !voice { root.open(it.id); }
                }
                double-clicked => {
                    if voice { root.join(it.id); }
                }
            }
            // right-click a member: our volume for them
            if it.member: TouchArea {
                pointer-event(e) => {
                    if e.button == PointerEventButton.right && e.kind == PointerEventKind.up { vol.show(); }
                }
            }
            vol := PopupWindow {
                x: 24px;
                y: parent.height;
                width: 190px;
                close-policy: PopupClosePolicy.close-on-click-outside;
                Rectangle {
                    background: Palette.background;
                    border-width: 1px;
                    border-color: Palette.border;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 2px;
                        Text {
                            text: "Volume " + round(slider.value) + " %";
                            font-size: 12px;
                        }
                        slider := Slider {
                            minimum: 0;
                            maximum: 200;
                            value: it.volume * 100;
                            changed(v) => { root.set-volume(it.id, v / 100); }
                        }
                        CheckBox {
                            text: "Mute for me";
                            checked: it.muted-for-me;
                            toggled => { root.set-muted-for-me(it.id, self.checked); }
                        }
                    }
                }
            }
        }
    }
}

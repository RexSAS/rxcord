import { Theme } from "theme.slint";
import { Button, Palette } from "std-widgets.slint";
import { LoginScreen } from "login.slint";
import { Splash } from "splash.slint";
import { Tree, TreeItem } from "tree.slint";
import { Tabs, TabItem } from "tabs.slint";
import { MessageList } from "messages.slint";
import { Composer } from "composer.slint";
import { MessageItem, ThumbItem, FileItem } from "message_row.slint";
import { VoiceSettings } from "voice_settings.slint";

export { TreeItem, TabItem, MessageItem, ThumbItem, FileItem }

export component AppWindow inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "rxcord";
    preferred-width: 360px;
    preferred-height: 640px;
    min-width: 280px;
    min-height: 400px;
    background: Theme.bg;

    in property <bool> logged-in;
    in property <image> qr;
    in property <string> login-status;
    in property <string> login-error;
    // saved-login session started, READY not yet received
    in property <bool> connecting: true;
    // Connection banner text; empty when connected.
    in property <string> banner;
    callback login-token(string);
    callback start-qr();
    callback logout();

    // source model for the panes below (Rust keeps it as a VecModel)
    in property <[TreeItem]> tree;
    // filtered views of `tree`: DMs (left) and servers (right)
    in property <[TreeItem]> friends;
    in property <[TreeItem]> servers;
    in property <[TabItem]> tabs;
    in property <[MessageItem]> messages;
    // the active tab
    in property <string> selected-channel;
    // your display name, for the status bar
    in property <string> me-name;
    // status bar update entry ("" = hidden) and what clicking it does ("install", "restart", "open:<url>", "")
    in property <string> update-label;
    in property <string> update-action;
    callback update-clicked(string);
    // voice bar text ("" = not in voice) and a short-lived status bar notice
    in property <string> voice;
    in property <string> notice;
    // the channel we're in or joining ("" = none)
    in property <string> voice-channel;
    callback join-voice(string);
    callback hang-up();
    // DM calls: a DM tab's 📞, and the incoming-call prompt ("" = none) with its buttons
    callback start-call(string);
    in property <string> call-prompt;
    callback accept-call();
    callback decline-call();
    // voice bar buttons and the mic's level dot (hears speech, not muted)
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in property <bool> voice-level;
    callback toggle-mute();
    callback toggle-deafen();
    // a voice member's volume (0..2) and "mute for me"
    callback set-user-volume(string, float);
    callback set-user-muted(string, bool);
    // voice settings popup (filled by Rust, then shown with show-voice-settings)
    callback open-voice-settings();
    in property <[string]> vs-inputs;
    in property <[string]> vs-outputs;
    in-out property <int> vs-input;
    in-out property <int> vs-output;
    in-out property <float> vs-threshold;
    in-out property <bool> vs-noise;
    callback voice-input(string);
    callback voice-output(string);
    callback voice-threshold(float);
    callback voice-noise(bool);
    public function show-voice-settings() { vs-popup.show(); }
    // height of the tree above the divider (saved in settings.json)
    in-out property <length> tree-height: 280px;
    // expand/collapse a tree node (guild id or "0" for DMs)
    callback toggle-node(string);
    // open a channel's tab, or activate it
    callback select-channel(string);
    callback close-tab(string);
    // Set (by Rust) together with `selected-channel` when the active channel was deleted: the composer
    // text moves to the next tab instead of being saved as the dead channel's draft.
    in-out property <bool> carry-draft;
    callback carry(string /*text*/, string /*to*/) -> string;
    // shown instead of messages when the first load failed
    in property <string> messages-error;
    callback retry();
    callback load-older();
    callback bottom-visible(bool);
    callback thumb-visible(string);
    // attachment link or image clicked
    callback open-url(string);

    // Composer state (see composer.slint); ids are "" when unset.
    in-out property <string> composer-text;
    in-out property <string> reply-id;
    in-out property <string> reply-author;
    in-out property <string> edit-id;
    in-out property <string> edit-stash;
    // composer text when the edit was submitted (Rust only)
    in-out property <string> edit-submitted;
    in-out property <string> composer-error;
    in-out property <string> row-error-id;
    in property <string> row-error;
    in property <bool> row-error-ok;
    // Join button of a server invite in a message
    callback join-invite(string /*message id*/, string /*code*/);
    callback send(string);
    // "" = your newest message in the channel
    callback start-edit(string);
    callback delete-message(string);
    callback retry-send(string /*nonce*/);
    // Per-channel drafts (kept in Rust): returns the draft of channel `to`, keeping `text` for the old one.
    callback switch-draft(string /*text*/, string /*to*/) -> string;
    // unsent text of an ended session, added to that channel's draft
    callback restore-draft(string /*channel*/, string /*text*/);
    // READY for user id: drafts of another account are dropped
    callback session-user(string);

    changed selected-channel => {
        composer.cancel();
        root.row-error-id = "";
        if root.carry-draft {
            root.carry-draft = false;
            if root.composer-text != "" { root.composer-error = "Channel was deleted — unsent text moved here"; }
            root.composer-text = root.carry(root.composer-text, root.selected-channel);
        } else {
            root.composer-text = root.switch-draft(root.composer-text, root.selected-channel);
        }
    }

    // Section borders: visible in both color schemes (Theme.line blends into the backgrounds).
    property <color> line: Theme.line;

    public function focus-composer() { composer.focus-input(); }
    public function scroll-to-bottom() { msgs.scroll-to-bottom(); }
    public function messages-prepended(n: int) { msgs.prepended(n); }

    VerticalLayout {
        Rectangle {
        // `visible` instead of `if`: the message list must exist for the public functions above.
        VerticalLayout {
            width: parent.width;
            height: parent.height;
            visible: root.logged-in;
            HorizontalLayout {
                height: root.tree-height;
                Tree {
                    horizontal-stretch: 1;
                    items: root.friends;
                    active: root.selected-channel;
                    toggle(id) => { root.toggle-node(id); }
                    open(id) => { root.select-channel(id); }
                    join(id) => { root.join-voice(id); }
                    set-volume(id, v) => { root.set-user-volume(id, v); }
                    set-muted-for-me(id, m) => { root.set-user-muted(id, m); }
                }
                Rectangle { width: 1px; background: root.line; }
                Tree {
                    horizontal-stretch: 1;
                    items: root.servers;
                    active: root.selected-channel;
                    toggle(id) => { root.toggle-node(id); }
                    open(id) => { root.select-channel(id); }
                    join(id) => { root.join-voice(id); }
                    set-volume(id, v) => { root.set-user-volume(id, v); }
                    set-muted-for-me(id, m) => { root.set-user-muted(id, m); }
                }
            }
            // divider: drag to resize the tree (5px to grab, drawn as a 2px line)
            Rectangle {
                height: 5px;
                Rectangle {
                    height: divider.has-hover || divider.pressed ? 3px : 2px;
                    background: divider.has-hover || divider.pressed ? Theme.accent : root.line;
                }
                divider := TouchArea {
                    mouse-cursor: row-resize;
                    moved => {
                        root.tree-height = clamp(root.tree-height + self.mouse-y - self.pressed-y, 60px, max(60px, root.height - 220px));
                    }
                }
            }
            Tabs {
                tabs: root.tabs;
                active: root.selected-channel;
                in-call: root.voice-channel;
                activate(id) => { root.select-channel(id); }
                close(id) => { root.close-tab(id); }
                call(id) => { root.start-call(id); }
                hang-up => { root.hang-up(); }
            }
            Rectangle { height: 1px; background: root.line; }
            Rectangle {
                vertical-stretch: 1;
                msgs := MessageList {
                    messages: root.messages;
                    error: root.messages-error;
                    retry => { root.retry(); }
                    load-older => { root.load-older(); }
                    bottom-visible(b) => { root.bottom-visible(b); }
                    thumb-visible(u) => { root.thumb-visible(u); }
                    open-url(u) => { root.open-url(u); }
                    row-error-id: root.row-error-id;
                    row-error: root.row-error;
                    row-error-ok: root.row-error-ok;
                    join-invite(m, c) => { root.join-invite(m, c); }
                    start-reply(id, author) => {
                        composer.cancel();
                        root.reply-id = id;
                        root.reply-author = author;
                        composer.focus-input();
                    }
                    start-edit(id) => { root.start-edit(id); }
                    delete(id) => {
                        root.row-error-id = "";
                        root.delete-message(id);
                    }
                    retry-send(nonce) => { root.retry-send(nonce); }
                }
                if root.selected-channel == "": Text {
                    text: "Pick a channel or DM above";
                    opacity: 0.5;
                }
            }
            Rectangle { height: 1px; background: root.line; }
            composer := Composer {
                visible: root.selected-channel != "";
                text <=> root.composer-text;
                reply-id <=> root.reply-id;
                reply-author: root.reply-author;
                edit-id <=> root.edit-id;
                stash <=> root.edit-stash;
                error <=> root.composer-error;
                send(t) => { root.send(t); }
                edit-last => { root.start-edit(""); }
            }
            Rectangle { height: 1px; background: root.line; }
            if root.voice != "": Rectangle {
                height: 22px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 6px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.voice;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                    Text {
                        text: "●";
                        vertical-alignment: center;
                        font-size: 9px;
                        color: root.voice-level ? Theme.ok : Theme.text;
                        opacity: root.voice-level ? 1.0 : 0.25;
                    }
                    mic := TouchArea {
                        width: 34px;
                        accessible-role: button;
                        accessible-label: root.voice-muted ? "Unmute" : "Mute";
                        accessible-action-default => { root.toggle-mute(); }
                        clicked => { root.toggle-mute(); }
                        Rectangle {
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: root.voice-muted ? Theme.danger : Theme.accent;
                            background: root.voice-muted ? Theme.danger-soft : Theme.accent-soft;
                            Text {
                                text: "Mic"; // the software renderer has no color emoji
                                horizontal-alignment: center;
                                font-size: 11px;
                                vertical-alignment: center;
                                opacity: mic.has-hover || root.voice-muted ? 1.0 : 0.7;
                            }
                        }
                    }
                    deaf := TouchArea {
                        width: 40px;
                        accessible-role: button;
                        accessible-label: root.voice-deafened ? "Undeafen" : "Deafen";
                        accessible-action-default => { root.toggle-deafen(); }
                        clicked => { root.toggle-deafen(); }
                        Rectangle {
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: root.voice-deafened ? Theme.danger : Theme.accent;
                            background: root.voice-deafened ? Theme.danger-soft : Theme.accent-soft;
                            Text {
                                text: "Audio";
                                horizontal-alignment: center;
                                font-size: 11px;
                                vertical-alignment: center;
                                opacity: deaf.has-hover || root.voice-deafened ? 1.0 : 0.7;
                            }
                        }
                    }
                    hang := TouchArea {
                        width: 20px;
                        accessible-role: button;
                        accessible-label: "Leave voice";
                        accessible-action-default => { root.hang-up(); }
                        clicked => { root.hang-up(); }
                        Text {
                            text: "✖";
                            vertical-alignment: center;
                            color: Theme.danger;
                            opacity: hang.has-hover ? 1.0 : 0.7;
                        }
                    }
                }
            }
            if root.voice != "": Rectangle { height: 1px; background: root.line; }
            if root.call-prompt != "": Rectangle {
                height: 22px;
                background: Theme.panel;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.call-prompt;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    accept := TouchArea {
                        width: accept-text.preferred-width;
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Accept call";
                        accessible-action-default => { root.accept-call(); }
                        clicked => { root.accept-call(); }
                        accept-text := Text {
                            text: "Accept";
                            color: Theme.ok;
                            font-size: 12px;
                            vertical-alignment: center;
                            opacity: accept.has-hover ? 1.0 : 0.8;
                        }
                    }
                    decline := TouchArea {
                        width: decline-text.preferred-width;
                        mouse-cursor: pointer;
                        accessible-role: button;
                        accessible-label: "Decline call";
                        accessible-action-default => { root.decline-call(); }
                        clicked => { root.decline-call(); }
                        decline-text := Text {
                            text: "Decline";
                            color: Theme.danger;
                            font-size: 12px;
                            vertical-alignment: center;
                            opacity: decline.has-hover ? 1.0 : 0.8;
                        }
                    }
                }
            }
            if root.call-prompt != "": Rectangle { height: 1px; background: root.line; }
            // status bar
            Rectangle {
                height: 22px;
                background: root.banner != "" ? Theme.warn : Theme.panel;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 6px;
                    Text {
                        text: "●";
                        vertical-alignment: center;
                        color: root.banner != "" ? white : Theme.ok;
                        font-size: 10px;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.banner != "" ? root.banner : root.notice != "" ? root.notice : "Connected · " + root.me-name;
                        color: root.banner != "" ? white : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        font-size: 12px;
                    }
                    if root.update-label != "": upd := TouchArea {
                        width: upd-text.preferred-width;
                        enabled: root.update-action != "";
                        mouse-cursor: self.enabled ? pointer : default;
                        accessible-role: button;
                        accessible-label: root.update-label;
                        accessible-action-default => { root.update-clicked(root.update-action); }
                        clicked => { root.update-clicked(root.update-action); }
                        upd-text := Text {
                            text: root.update-label;
                            color: Theme.ok;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    gear := TouchArea {
                        width: 20px;
                        accessible-role: button;
                        accessible-label: "Menu";
                        accessible-action-default => { menu.show(); }
                        clicked => { menu.show(); }
                        Text {
                            text: "⚙";
                            vertical-alignment: center;
                            opacity: gear.has-hover ? 1.0 : 0.7;
                        }
                    }
                }
                menu := PopupWindow {
                    x: parent.width - 150px;
                    y: -66px;
                    width: 140px;
                    Rectangle {
                        background: Theme.bg;
                        border-width: 1px;
                        border-color: Theme.line;
                        VerticalLayout {
                            Button {
                                text: "Voice settings…";
                                clicked => { root.open-voice-settings(); }
                            }
                            Button {
                                text: "Log out";
                                clicked => { root.logout(); }
                            }
                        }
                    }
                }
            }
        }
        vs-popup := PopupWindow {
            x: 8px;
            y: 8px;
            width: parent.width - 16px;
            close-policy: PopupClosePolicy.close-on-click-outside;
            VoiceSettings {
                inputs: root.vs-inputs;
                outputs: root.vs-outputs;
                input <=> root.vs-input;
                output <=> root.vs-output;
                threshold <=> root.vs-threshold;
                noise <=> root.vs-noise;
                input-changed(d) => { root.voice-input(d); }
                output-changed(d) => { root.voice-output(d); }
                threshold-changed(t) => { root.voice-threshold(t); }
                noise-changed(n) => { root.voice-noise(n); }
            }
        }
        if !root.logged-in && root.connecting: Splash {
            width: parent.width;
            height: parent.height;
            status: root.banner != "" ? root.banner : "Loading your servers…";
            logout => { root.logout(); }
        }
        if !root.logged-in && !root.connecting: LoginScreen {
            width: parent.width;
            height: parent.height;
            background: Theme.bg;
            qr: root.qr;
            status: root.login-status;
            error: root.login-error;
            login-token(t) => { root.login-token(t); }
            start-qr => { root.start-qr(); }
            logout => { root.logout(); }
        }
        }
    }
}

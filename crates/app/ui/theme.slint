// rxcord's look: dark gaming theme, purple neon accent, cyan for "speaking". All colors live here.
export global Theme {
    out property <color> bg: #0b0b12;
    out property <color> panel: #12121c;
    out property <color> card: #191926;
    out property <color> hover: #22223a;
    out property <color> line: #2a2a40;
    out property <color> text: #e8e6f5;
    out property <color> dim: #8b89a6;
    out property <color> accent: #a855f7;
    out property <color> accent-soft: #a855f733;
    out property <color> glow: #22d3ee;
    out property <color> ok: #39ff88;
    out property <color> danger: #ff4d6d;
    out property <color> danger-soft: #ff4d6d40;
    out property <color> danger-tint: #ff4d6d1a;
    out property <color> warn: #f59e0b;
    out property <color> link: #67e8f9;
    out property <length> radius: 6px;
}

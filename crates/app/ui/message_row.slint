import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";

export struct ThumbItem {
    // sized proxy URL (cache key)
    url: string,
    // full-size URL, opened on click
    full: string,
    width: int,
    height: int,
    // empty until loaded (or for good if the fetch failed)
    image: image,
}

export struct FileItem {
    name: string,
    url: string,
}

export struct MessageItem {
    id: string,
    author: string,
    time: string,
    // the whole text, header ("HH:MM Name: ") included
    body: styled-text,
    reply: string,
    thumbs: [ThumbItem],
    files: [FileItem],
    // server invite codes found in the text
    invites: [string],
    edited: bool,
    pending: bool,
    failed: bool,
    mine: bool,
}

component Action inherits TouchArea {
    in property <string> text;
    in property <color> color: Theme.accent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.text;
        color: root.color;
        font-size: 12px;
        vertical-alignment: center;
    }
}

// Compact row: "HH:MM Name: text" (the header is part of the first paragraph, built in Rust).
// Actions live in the right-click menu; Delete asks for a confirmation inline.
export component MessageRow inherits VerticalLayout {
    in property <MessageItem> msg;
    // inline error for this row ("" = none)
    in property <string> error;
    // the note under the row is good news (e.g. "Joined …"), not an error
    in property <bool> error-ok;
    callback join(string /*invite code*/);
    callback thumb-visible(string);
    callback open-url(string);
    callback start-reply(string, string);
    callback start-edit(string);
    callback delete(string);
    callback retry(string);

    property <bool> confirm;
    property <string> link: root.msg.files.length > 0 ? root.msg.files[0].url
        : root.msg.thumbs.length > 0 ? root.msg.thumbs[0].full : "";

    // Each message is a card with a gap around it, so single messages are easy to tell apart.
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    Rectangle {
        background: root.msg.failed ? Theme.danger-tint : Theme.card;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: root.msg.mine ? Theme.accent-soft : Theme.line;
        // own messages: a neon edge on the left
        Rectangle {
            x: 0;
            width: 3px;
            visible: root.msg.mine;
            border-radius: 1px;
            background: Theme.accent;
        }
        lay := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 3px;
            if root.msg.reply != "": Text {
                text: "  ↪ " + root.msg.reply;
                font-size: 11px;
                opacity: 0.6;
                overflow: elide;
            }
            // A plain repeated StyledText: nested in another element it loses its wrapped height (rows overlap).
            // One StyledText directly in the layout: repeated ones were measured unwrapped (rows overlapped).
            StyledText {
                text: root.msg.body;
                opacity: root.msg.pending && !root.msg.failed ? 0.5 : 1.0;
                default-color: root.msg.failed ? Theme.danger : Theme.text;
                link-color: Theme.link;
            link-clicked(url) => { root.open-url(url); }
            }
            for f in root.msg.files: HorizontalLayout {
                alignment: start;
                Action {
                    text: "↓ " + f.name;
                    clicked => { root.open-url(f.url); }
                }
            }
            for code in root.msg.invites: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: "Server invite · " + code;
                    font-size: 12px;
                    opacity: 0.8;
                    vertical-alignment: center;
                }
                Action {
                    text: "Join";
                    clicked => { root.join(code); }
                }
            }
            for t in root.msg.thumbs: HorizontalLayout {
                alignment: start;
                // fixed size from the attachment's dimensions: no layout jump when the image arrives
                TouchArea {
                    width: t.width * 1px;
                    height: t.height * 1px;
                    mouse-cursor: pointer;
                    accessible-role: button;
                    accessible-label: "Open image";
                    accessible-action-default => { root.open-url(t.full); }
                    init => { root.thumb-visible(t.url); }
                    clicked => { root.open-url(t.full); }
                    Rectangle {
                        border-radius: 3px;
                        clip: true;
                        background: Theme.bg; // darker than the card
                        Image {
                            source: t.image;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                }
            }
            if root.msg.failed: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: "Failed to send";
                    color: Theme.danger;
                    font-size: 11px;
                }
                Action {
                    text: "Retry";
                    clicked => { root.retry(root.msg.id); }
                }
            }
            if root.confirm: HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: "Delete this message?";
                    font-size: 11px;
                }
                Action {
                    text: "Delete";
                    color: Theme.danger;
                    clicked => {
                        root.confirm = false;
                        root.delete(root.msg.id);
                    }
                }
                Action {
                    text: "Cancel";
                    clicked => { root.confirm = false; }
                }
            }
            if root.error != "": Text {
                text: root.error;
                color: root.error-ok ? Theme.ok : Theme.danger;
                font-size: 11px;
            }
        }
        // On top of the content (wrapping it breaks the row height; below it, the text swallows right-clicks).
        // It only takes right-clicks/long-presses; left clicks reach the links and buttons underneath.
        ContextMenuArea {
            width: 100%;
            height: 100%;
            enabled: !root.msg.pending;
            Menu {
                MenuItem {
                    title: "Reply";
                    activated => { root.start-reply(root.msg.id, root.msg.author); }
                }
                if root.msg.mine: MenuItem {
                    title: "Edit";
                    activated => { root.start-edit(root.msg.id); }
                }
                if root.link != "": MenuItem {
                    title: "Open attachment";
                    activated => { root.open-url(root.link); }
                }
                if root.msg.mine: MenuItem {
                    title: "Delete…";
                    activated => { root.confirm = true; }
                }
            }
        }
    }
}

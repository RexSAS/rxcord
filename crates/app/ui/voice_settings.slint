import { Theme } from "theme.slint";
import { CheckBox, ComboBox, Slider, Palette } from "std-widgets.slint";

// ⚙ → "Voice settings…": devices, speech threshold, noise suppression. Changes apply at once.
export component VoiceSettings inherits Rectangle {
    // device names; entry 0 is "System default"
    in property <[string]> inputs;
    in property <[string]> outputs;
    in-out property <int> input;
    in-out property <int> output;
    // voice activity sensitivity, 0.1..0.95 (speech probability needed to send)
    in-out property <float> threshold;
    in-out property <bool> noise;
    // device name, "" = system default
    callback input-changed(string);
    callback output-changed(string);
    callback threshold-changed(float);
    callback noise-changed(bool);

    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text { text: "Microphone"; font-size: 12px; }
        ComboBox {
            model: root.inputs;
            current-index <=> root.input;
            selected(v) => { root.input-changed(self.current-index == 0 ? "" : v); }
        }
        Text { text: "Speaker"; font-size: 12px; }
        ComboBox {
            model: root.outputs;
            current-index <=> root.output;
            selected(v) => { root.output-changed(self.current-index == 0 ? "" : v); }
        }
        Text { text: "Sensitivity: send above " + round(root.threshold * 100) + " % speech"; font-size: 12px; }
        Slider {
            minimum: 0.1;
            maximum: 0.95;
            step: 0.05;
            value <=> root.threshold;
            changed(v) => { root.threshold-changed(v); }
        }
        CheckBox {
            text: "Noise suppression";
            checked <=> root.noise;
            toggled => { root.noise-changed(self.checked); }
        }
    }
}

import { ListView } from "std-widgets.slint";
import { MessageRow, MessageItem } from "message_row.slint";

export component MessageList inherits Rectangle {
    in property <[MessageItem]> messages;
    in property <string> error;
    callback retry();
    callback load-older();
    // true while the newest message is on screen
    callback bottom-visible(bool);
    callback thumb-visible(string);
    callback open-url(string);
    // inline error under the row with this id
    in property <string> row-error-id;
    in property <string> row-error;
    in property <bool> row-error-ok;
    callback join-invite(string /*message id*/, string /*code*/);
    callback start-reply(string, string);
    callback start-edit(string);
    callback delete(string);
    callback retry-send(string);

    // Follow new messages while the user is at the bottom.
    property <bool> stick: true;
    changed stick => { root.bottom-visible(self.stick); }

    public function scroll-to-bottom() {
        root.stick = true;
        list.content-y = min(0px, list.visible-height - list.content-height);
    }

    // Older rows were inserted above: keep the visible rows roughly in place.
    public function prepended(n: int) {
        list.content-y -= n * list.content-height / max(1, root.messages.length);
    }

    list := ListView {
        for m in root.messages: MessageRow {
            msg: m;
            error: m.id == root.row-error-id ? root.row-error : "";
            error-ok: root.row-error-ok;
            join(code) => { root.join-invite(m.id, code); }
            thumb-visible(u) => { root.thumb-visible(u); }
            open-url(u) => { root.open-url(u); }
            start-reply(id, author) => { root.start-reply(id, author); }
            start-edit(id) => { root.start-edit(id); }
            delete(id) => { root.delete(id); }
            retry(nonce) => { root.retry-send(nonce); }
        }
        changed content-height => {
            if root.stick { root.scroll-to-bottom(); }
        }
        changed visible-height => {
            if root.stick { root.scroll-to-bottom(); }
        }
        // user scrolling only (wheel, drag, scrollbar); programmatic scrolls don't count
        scrolled => {
            root.stick = self.content-y <= self.visible-height - self.content-height + 8px;
            if self.content-y > -200px { root.load-older(); }
        }
    }

    if root.error != "": TouchArea {
        clicked => { root.retry(); }
        accessible-role: button;
        accessible-label: root.error;
        accessible-action-default => { root.retry(); }
        Text {
            text: root.error;
            opacity: 0.7;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

import { Theme } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { Badge } from "widgets.slint";

export struct TabItem {
    id: string,
    name: string,
    kind: int,
    unread: bool,
    mentions: int,
}

// One tab per open channel or DM. Click activates, × or middle click closes. The active DM's 📞
// starts a call; while we're in that call it's ✖ (hang up).
export component Tabs inherits Rectangle {
    in property <[TabItem]> tabs;
    in property <string> active;
    // the voice channel or call we're in ("" = none)
    in property <string> in-call;
    callback activate(string);
    callback close(string);
    callback call(string);
    callback hang-up();

    height: 26px;
    background: Theme.panel;
    Flickable {
        content-width: max(self.width, row.preferred-width);
        row := HorizontalLayout {
            alignment: start;
            for t in root.tabs: Rectangle {
                property <bool> on: t.id == root.active;
                background: on ? Theme.bg : ta.has-hover ? Theme.hover : transparent;
                Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    visible: on;
                    background: Theme.accent;
                }
                accessible-role: tab;
                accessible-label: t.name;
                accessible-item-selected: on;
                accessible-action-default => { root.activate(t.id); }
                ta := TouchArea {
                    clicked => { root.activate(t.id); }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.middle && e.kind == PointerEventKind.up { root.close(t.id); }
                    }
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    spacing: 4px;
                    Text {
                        text: (t.kind == 1 || t.kind == 3 ? "" : "#") + t.name;
                        vertical-alignment: center;
                        max-width: 140px;
                        overflow: elide;
                        font-size: 12px;
                        font-weight: t.unread && !on ? 700 : 400;
                    }
                    Badge {
                        y: (parent.height - self.height) / 2;
                        count: on ? 0 : t.mentions;
                    }
                    if on && (t.kind == 1 || t.kind == 3): ph := TouchArea {
                        property <bool> in-it: root.in-call == t.id;
                        width: 18px;
                        accessible-role: button;
                        accessible-label: in-it ? "Hang up" : "Call " + t.name;
                        accessible-action-default => { if in-it { root.hang-up(); } else { root.call(t.id); } }
                        clicked => { if in-it { root.hang-up(); } else { root.call(t.id); } }
                        Text {
                            text: in-it ? "✖" : "☎";
                            color: in-it ? Theme.danger : Theme.text;
                            opacity: ph.has-hover ? 1.0 : 0.7;
                            vertical-alignment: center;
                        }
                    }
                    x := TouchArea {
                        width: 14px;
                        accessible-role: button;
                        accessible-label: "Close " + t.name;
                        accessible-action-default => { root.close(t.id); }
                        clicked => { root.close(t.id); }
                        Text {
                            text: "×";
                            opacity: x.has-hover ? 1.0 : 0.5;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
